# Configuração do Monitor de Logs
# Caminho para o arquivo de log bruto gerado pelo sistema
LOG_SOURCE_PATH=logs/sistema.log

# Configurações de Saída da Auditoria
# Caminho para o arquivo de texto estruturado com a auditoria limpa
AUDIT_TEXT_PATH=logs/auditoria.txt

# URL do Banco de Dados para o SQLAlchemy (SQLite por padrão, pode ser alterado para SQL Server/Postgres)
DATABASE_URL=sqlite:///logs/auditoria.db

# Modo de Armazenamento: "text" (apenas texto), "db" (apenas banco), ou "both" (ambos)
AUDIT_STORAGE_MODE=both

# Expressão Regular do Analisador de Logs
# Por padrão, espera o formato: YYYY-MM-DD HH:MM:SS [LEVEL] [PROGRAM] [MODULE] - MESSAGE
# Os grupos de captura (Regex capture groups) devem ser estritamente: (?P<timestamp>...), (?P<nome_programa>...), (?P<modulo_sistema>...), (?P<mensagem_erro>...)
LOG_PARSER_REGEX=^(?P<timestamp>\d{4}-\d{2}-\d{2}\s\d{2}:\d{2}:\d{2})\s+\[(?P<level>ERROR|Exception)\]\s+\[(?P<nome_programa>[^\]]+)\]\s+\[(?P<modulo_sistema>[^\]]+)\]\s+-\s+(?P<mensagem_erro>.+)$

# Modo de Depuração (true/false)
DEBUG=false
