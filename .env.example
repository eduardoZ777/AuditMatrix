# Log Monitor Configuration
# Path to the raw log file generated by the ERP system
LOG_SOURCE_PATH=logs/sistema.log

# Audit Output Configuration
# Path to the structured text file audit output
AUDIT_TEXT_PATH=logs/auditoria.txt

# Database URL for SQLAlchemy (SQLite by default, can be changed to SQL Server/Postgres)
DATABASE_URL=sqlite:///logs/auditoria.db

# Storage Mode: "text", "db", or "both"
AUDIT_STORAGE_MODE=both

# Log Parser Regular Expression
# By default, it expects: YYYY-MM-DD HH:MM:SS [LEVEL] [PROGRAM] [MODULE] - MESSAGE
# Regex capture groups must be: (?P<timestamp>...), (?P<nome_programa>...), (?P<modulo_sistema>...), (?P<mensagem_erro>...)
LOG_PARSER_REGEX=^(?P<timestamp>\d{4}-\d{2}-\d{2}\s\d{2}:\d{2}:\d{2})\s+\[(?P<level>ERROR|Exception)\]\s+\[(?P<nome_programa>[^\]]+)\]\s+\[(?P<modulo_sistema>[^\]]+)\]\s+-\s+(?P<mensagem_erro>.+)$

# Debug Mode
DEBUG=false
